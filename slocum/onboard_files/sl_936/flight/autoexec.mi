# autoexec.mi for unit 936
					
# Date		e-mail address			comment
# 08-11-2021    Aritterbush@teledyne.com        initial setting
# 08/29/2024	karl.boettger@teledyne.com	updated f_coulomb_battery_capacity(amp-hrs) to 4S lithium batteries
#09/10/2024 changed primary Iridium number, EA
# Changed to rechargeable battery 24/10/2025, EA
# Swapped pump to deep pump, changed name 14/1/2026, EA
# Swapped back to shallow, 16/1/2026, EA


name slo_936

# SERIAL NUMBER RECORD						

# Forward section assy	#146
